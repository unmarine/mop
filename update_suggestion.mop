xroot	"Biblical Hebrew".

from	"root" text "Root system"	as "rootsys".
from	"rootsys" texts [
		"All verbs"",
		"All derived nouns",
		"Most adjectives"
].

from	"root" text "Phonetics"		as "phonetics".
from	"phonetics" texts [
		"Long and short vowels",
		"Matres lectionis",
		"Full and defective spellings",
		"Shewa"						as "shewa",
		"Stress"					as "stress"
].

from	"stress" texts [
		"Mostly ultimate"						
		"Less frequently penultimate"			
].

from	"shewa" text "Vocal"		as "shewavoc".
from	"shewavoc" texts [
		"Beginning of the word"				
		"Second of two conseq shew				
		"After strong dagesh consonant"		
		"After a long vowel"					
].


from	"shewa" text "Silent"		as "shewasil".
from	"shew						asil" texts [
		"End of word"							
		"First of two shew					
		"After short unstressed vowel"		
		"Immediately after stressed syllable" 
].

from	"shewa" text "Composite"	as "shewacomp".
from	"shewacomp" texts [
		"Always vocal"		
		"Gutturals"					as "gutturals".

]

from	"gutturals" texts [
		"Pronounced in throat"					
		"Aleph; Hey; Het; Ayin"				
].


